{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "metadata",
    "test_cases"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "module",
        "feature",
        "owner",
        "last_reviewed"
      ],
      "properties": {
        "module": {
          "type": "string",
          "description": "Parent module"
        },
        "feature": {
          "type": "string",
          "description": "Focused feature for this file"
        },
        "owner": {
          "type": "string",
          "description": "Owner, preferably an English name"
        },
        "last_reviewed": {
          "type": "string",
          "format": "date",
          "description": "Last review date (YYYY-MM-DD)"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "File-level tags"
        },
        "source_binding": {
          "type": "object",
          "required": [
            "canonical_path",
            "canonical_sha256",
            "projection_sha256",
            "case_set_id",
            "scope_id",
            "input_mode",
            "review_date_sentinel"
          ],
          "properties": {
            "canonical_path": {
              "type": "string",
              "minLength": 1
            },
            "canonical_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "projection_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "case_set_id": {
              "type": "string",
              "minLength": 1
            },
            "scope_id": {
              "type": "string",
              "minLength": 1
            },
            "input_mode": {
              "type": "string",
              "enum": [
                "standalone",
                "hiwiki"
              ]
            },
            "review_date_sentinel": {
              "type": "boolean"
            },
            "spec_sha256": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "knowledge_delivery": {
              "type": "string",
              "minLength": 1
            },
            "knowledge_commit": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "description": "Machine binding for a derived Case Set; not a user tag"
        }
      },
      "additionalProperties": false
    },
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "steps",
          "expected_results",
          "priority",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TC_[A-Z0-9_]{3,}_[0-9]{3}$",
            "description": "Globally unique ID, format TC_<FEATURE_PREFIX>_<NNN>"
          },
          "title": {
            "type": "string",
            "description": "Concise action-oriented title"
          },
          "description": {
            "type": "string",
            "description": "Additional description (optional)"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ],
            "description": "Priority"
          },
          "type": {
            "type": "string",
            "enum": [
              "functional",
              "ui",
              "security",
              "performance",
              "accessibility",
              "business",
              "other",
              "data-consistency"
            ],
            "description": "Case type"
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Preconditions (optional)"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Execution steps, one action per item"
          },
          "expected_results": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Expected results, one or more items"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Case-level tags"
          },
          "auto": {
            "type": "boolean",
            "default": false,
            "description": "Whether the case is planned for automation (default false)"
          },
          "traceability": {
            "type": "object",
            "required": [
              "canonical_id",
              "revision",
              "case_set_id",
              "requirement_refs",
              "coverage_refs",
              "evidence_refs",
              "assertions"
            ],
            "properties": {
              "canonical_id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "case_set_id": {
                "type": "string",
                "minLength": 1
              },
              "requirement_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "coverage_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_refs": {
                "type": "object",
                "properties": {
                  "rule_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "change_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "contract_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "policy_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "metric_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              },
              "assertions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "assertion_id",
                    "step_no",
                    "assertion_type",
                    "evidence_refs"
                  ],
                  "properties": {
                    "assertion_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "step_no": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "assertion_type": {
                      "type": "string",
                      "enum": [
                        "business",
                        "technical"
                      ]
                    },
                    "evidence_refs": {
                      "type": "object",
                      "properties": {
                        "rule_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "change_refs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "contract_refs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "policy_refs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "metric_refs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "description": "Assertion identities and evidence kept out of expected result display text"
              }
            },
            "additionalProperties": false,
            "description": "Canonical identity and requirement coverage for a derived case; not a user tag"
          },
          "test_data": {
            "type": "object",
            "description": "Structured test data shown in the expanded case details"
          },
          "cleanup": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Cleanup actions shown in the expanded case details"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
